{
  "name": "danturizo-portafolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "media:inventory": "node --env-file-if-exists=.env.local scripts/media.mjs inventory",
    "media:review": "node --env-file-if-exists=.env.local scripts/media.mjs review",
    "media:prepare": "node --env-file-if-exists=.env.local scripts/media.mjs prepare",
    "media:dry-run": "node --env-file-if-exists=.env.local scripts/media.mjs upload --dry-run",
    "media:upload": "node --env-file-if-exists=.env.local scripts/media.mjs upload",
    "verify:projects": "node scripts/verify-projects.mjs",
    "measure:projects": "node scripts/measure-projects.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.23",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "motion": "^12.23.26",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/lib-storage": "3.1170.0",
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
